# Copy to .env and fill in. .env is never committed.
# .env 로 복사해 채운다. .env 는 커밋하지 않는다.
#
# These values differ per deployment, so the config files reference them
# instead of hard-coding. No file needs to be copied and edited.
# 배포마다 달라지는 값이라 설정 파일이 여기를 참조한다. 복사해 고칠 파일은 없다.

# Log collector host — Loki (3100) and ClickHouse (8123).
# 로그 수집 서버. Loki(3100) 와 ClickHouse(8123).
LOG_HOST=

# Label this host carries in the logs.
# 로그에 붙는 이 호스트의 라벨.
NRO_HOSTNAME=

# ClickHouse password for the vector sink.
# vector 가 ClickHouse 에 쓸 때 쓰는 비밀번호.
CH_PASSWORD=

# Client name of synthetic traffic to exclude from statistics.
# Leave as a name that matches nothing if there is none.
# 통계에서 제외할 합성 트래픽의 client 이름. 없으면 아무것도 안 맞는 값으로 둔다.
SYNTHETIC_CLIENT=none

# Loopback shared secret between freeradius and radsecproxy.
# ⚠️ Must equal LOCALHOST_SECRET in secrets.d/nro.cfg. They are two formats
#    for the same value; FreeRADIUS reads one and radsecproxy the other.
# freeradius 와 radsecproxy 사이 루프백 공유키.
# ⚠️ secrets.d/nro.cfg 의 LOCALHOST_SECRET 과 같아야 한다. 형식이 달라
#    두 곳에 적지만 값은 하나다.
LOCALHOST_SECRET=

# International ETLR endpoints. Confirm with the federation operator.
# 국제 ETLR 엔드포인트. 연합 운영자에게 확인할 것.
ETLR_HOST_1=
ETLR_HOST_2=
